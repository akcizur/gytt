{
  "name": "gytt",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build",
    "gltfjsx:character": "gltfjsx public/assets/characters/RobotExpressive.glb --types --keepnames --shadows --output src/modelObj/playerCharacter.gltfjsx"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "gltfjsx": "6.5.2",
    "typescript": "5.9.2",
    "vite": "8.3.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
